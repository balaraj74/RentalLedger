# Frontend mode: mock or postgres-api. The starter defaults to mock mode.
NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side only. Never prefix database secrets with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Configure only when a real authentication provider/server session is implemented.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000

# Optional embedding service settings; server-side only.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
